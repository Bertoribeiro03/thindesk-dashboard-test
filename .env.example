# não versione segredos
# Spring Boot: caminhos relativos ao diretório de execução (raiz do projeto).
THINDESK_DB_PATH=api/data/thindesk.db
THINDESK_DATA_SOURCE=local_sqlite
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SERVER_CONTEXT_PATH=
# Inicialização idempotente; nunca apaga chamados existentes.
THINDESK_INITIALIZE=true
THINDESK_SEED_EXAMPLE=false
# Login opcional para o ambiente local. Ao habilitar, configure as duas variáveis.
THINDESK_SECURITY_ENABLED=false
THINDESK_USERNAME=
THINDESK_PASSWORD=
THYMELEAF_CACHE=true
